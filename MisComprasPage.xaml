<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.MisComprasPage"
             Title="Mi Perfil"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="16">

        <!-- HEADER PERFIL -->
        <Border Grid.Row="0"
                BackgroundColor="#111111"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                Padding="22">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        WidthRequest="74"
                        HeightRequest="74">
                    <Label Text="👤"
                           FontSize="36"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="4">
                    <Label Text="Mi perfil"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Administra direcciones y revisa tus pedidos."
                           FontSize="14"
                           TextColor="#D1D1D6"/>
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="⚙️"
                       FontSize="30"
                       VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18">

                <!-- TABS -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                    <Border x:Name="TabDireccionesFrame"
                            Grid.Column="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26"
                            BackgroundColor="#111111"
                            Padding="0">

                        <Button Text="📍&#10;Direcciones"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="110"
                                BackgroundColor="Transparent"
                                Clicked="OnTabDireccionesClicked"/>
                    </Border>

                    <Border x:Name="TabComprasFrame"
                            Grid.Column="1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26"
                            BackgroundColor="#6E6E73"
                            Padding="0">

                        <Button Text="🛍️&#10;Mis pedidos"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="110"
                                BackgroundColor="Transparent"
                                Clicked="OnTabComprasClicked"/>
                    </Border>
                </Grid>

                <!-- SECCIÓN DIRECCIONES -->
                <VerticalStackLayout x:Name="SeccionDirecciones"
                                     IsVisible="True"
                                     Spacing="16">

                    <Border BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 28"
                            Padding="20">

                        <VerticalStackLayout Spacing="16">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border BackgroundColor="#111111"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        WidthRequest="54"
                                        HeightRequest="54">
                                    <Label Text="🏠"
                                           FontSize="26"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Dirección de entrega"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#111111"/>

                                    <Label Text="Guarda o edita la ubicación donde recibirás tus pedidos."
                                           FontSize="13"
                                           TextColor="#6E6E73"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,0">
                                    <Picker x:Name="SavedAddressesPicker"
                                            Title="Elegir dirección"
                                            SelectedIndexChanged="OnSavedAddressChanged"
                                            TextColor="#111111"
                                            TitleColor="#8E8E93"/>
                                </Border>

                                <Button Grid.Column="1"
                                        Text="🗑️"
                                        BackgroundColor="#FFECEC"
                                        TextColor="#FF3B30"
                                        Clicked="OnDeleteAddressClicked"
                                        WidthRequest="54"
                                        HeightRequest="54"
                                        CornerRadius="18"
                                        FontSize="20"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E5E5EA"/>

                            <Border BackgroundColor="#F2F2F7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,4">
                                <Entry x:Name="NombreDireccionEntry"
                                       Placeholder="Nombre de dirección  Ej: Mi Casa"
                                       PlaceholderColor="#8E8E93"
                                       TextColor="#111111"
                                       FontAttributes="Bold"
                                       BackgroundColor="Transparent"/>
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="12"
                                  ColumnSpacing="12">

                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,4">
                                    <Entry x:Name="CPEntry"
                                           Placeholder="C.P."
                                           PlaceholderColor="#8E8E93"
                                           TextColor="#111111"
                                           Keyboard="Numeric"
                                           MaxLength="5"
                                           BackgroundColor="Transparent"
                                           TextChanged="OnCPTextChanged"/>
                                </Border>

                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,4">
                                    <Entry x:Name="CiudadEntry"
                                           Placeholder="Ciudad"
                                           PlaceholderColor="#8E8E93"
                                           TextColor="#111111"
                                           IsEnabled="False"
                                           BackgroundColor="Transparent"/>
                                </Border>

                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,4">
                                    <Entry x:Name="ColoniaEntry"
                                           Placeholder="Colonia"
                                           PlaceholderColor="#8E8E93"
                                           TextColor="#111111"
                                           BackgroundColor="Transparent"/>
                                </Border>

                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,4">
                                    <Entry x:Name="CalleEntry"
                                           Placeholder="Calle"
                                           PlaceholderColor="#8E8E93"
                                           TextColor="#111111"
                                           BackgroundColor="Transparent"/>
                                </Border>

                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,4">
                                    <Entry x:Name="NumeroEntry"
                                           Placeholder="Número"
                                           PlaceholderColor="#8E8E93"
                                           TextColor="#111111"
                                           BackgroundColor="Transparent"/>
                                </Border>
                            </Grid>

                            <Button Text="💾 Guardar cambios"
                                    BackgroundColor="#111111"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    HeightRequest="56"
                                    CornerRadius="20"
                                    Clicked="OnSaveAddressClicked"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- MAPA -->
                    <Border StrokeShape="RoundRectangle 28"
                            StrokeThickness="0"
                            HeightRequest="260"
                            BackgroundColor="#111111">

                        <Grid>
                            <WebView x:Name="MapView"
                                     Navigated="MapView_Navigated"/>

                            <Image x:Name="MapFallbackImage"
                                   IsVisible="False"
                                   Aspect="AspectFill"/>

                            <Label x:Name="MapErrorLabel"
                                   Text="No se pudo cargar el mapa."
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="White"
                                   BackgroundColor="#99000000"
                                   Padding="14"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- SECCIÓN COMPRAS -->
                <VerticalStackLayout x:Name="SeccionCompras"
                                     IsVisible="False"
                                     Spacing="15">

                    <Label Text="Historial de pedidos"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#111111"/>

                    <CollectionView x:Name="OrdenesList"
                                    SelectionMode="Single"
                                    SelectionChanged="OnOrdenSelected">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Orden">

                                <Border BackgroundColor="White"
                                        Stroke="#E5E5EA"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 26"
                                        Padding="18"
                                        Margin="0,6">

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="14">

                                        <Border BackgroundColor="#111111"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 20"
                                                WidthRequest="64"
                                                HeightRequest="64">
                                            <Label Text="📦"
                                                   FontSize="30"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Fecha, StringFormat='{0:dd MMM, yyyy}'}"
                                                   FontAttributes="Bold"
                                                   FontSize="17"
                                                   TextColor="#111111"/>

                                            <Label Text="{Binding MetodoPago}"
                                                   FontSize="13"
                                                   TextColor="#6E6E73"/>

                                            <Label Text="Toca para ver detalles"
                                                   FontSize="12"
                                                   TextColor="#8E8E93"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Center"
                                                             Spacing="6">

                                            <Label Text="{Binding Total, StringFormat='{0:C2}'}"
                                                   FontAttributes="Bold"
                                                   TextColor="#111111"
                                                   FontSize="20"
                                                   HorizontalTextAlignment="End"/>

                                            <Button Text="Seguimiento"
                                                    FontSize="12"
                                                    CornerRadius="14"
                                                    BackgroundColor="#111111"
                                                    TextColor="White"
                                                    HeightRequest="34"
                                                    Padding="12,0"
                                                    Clicked="OnVerSeguimientoClicked"
                                                    CommandParameter="{Binding .}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>