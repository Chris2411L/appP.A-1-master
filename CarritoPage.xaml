<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.CarritoPage"
             Title="Mi Carrito"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="18"
          RowSpacing="16">

        <!-- HEADER -->
        <Grid x:Name="HeaderPanel"
              Grid.Row="0"
              ColumnDefinitions="*,Auto">

            <VerticalStackLayout>
                <Label Text="Mi carrito"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#111"/>
                <Label Text="Revisa tus productos"
                       FontSize="14"
                       TextColor="#6E6E73"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Vaciar"
                    BackgroundColor="#111"
                    TextColor="White"
                    CornerRadius="14"
                    Clicked="OnVaciarClicked"/>
        </Grid>

        <!-- VACÍO -->
        <VerticalStackLayout x:Name="EmptyState"
                             Grid.Row="1"
                             IsVisible="False"
                             Spacing="10"
                             VerticalOptions="Center"
                             HorizontalOptions="Center">

            <Label Text="🛒" FontSize="40"/>
            <Label Text="Tu carrito está vacío"
                   FontSize="20"
                   FontAttributes="Bold"/>
            <Button Text="Ir a comprar"
                    Clicked="OnSeguirComprandoClicked"/>
        </VerticalStackLayout>

        <!-- LISTA -->
        <CollectionView x:Name="ItemsList"
                        Grid.Row="1"
                        ItemsSource="{Binding Productos}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Producto">

                    <Frame CornerRadius="20"
                           Padding="10"
                           Margin="0,5"
                           BackgroundColor="White"
                           BorderColor="#DDD">

                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <!-- IMAGEN -->
                            <Frame WidthRequest="80"
                                   HeightRequest="80"
                                   Padding="0"
                                   CornerRadius="15"
                                   BackgroundColor="#EEE"
                                   HasShadow="False">

                                <Image Source="{Binding Imagen}"
                                       Aspect="AspectFill"/>
                            </Frame>

                            <!-- INFO -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Margin="10,0"
                                                 VerticalOptions="Center">

                                <Label Text="{Binding Nombre}"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                       TextColor="Green"/>

                                <Label Text="{Binding Subtotal, StringFormat='Subtotal: ${0:F2}'}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <!-- CONTROLES -->
                            <VerticalStackLayout Grid.Column="2"
                                                 VerticalOptions="Center">

                                <HorizontalStackLayout>

                                    <Button Text="-"
                                            WidthRequest="35"
                                            HeightRequest="35"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnReducirCantidadClicked"/>

                                    <Label Text="{Binding Cantidad}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           Margin="5,0"/>

                                    <Button Text="+"
                                            WidthRequest="35"
                                            HeightRequest="35"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnAumentarCantidadClicked"/>
                                </HorizontalStackLayout>

                                <Button Text="Quitar"
                                        FontSize="12"
                                        TextColor="Red"
                                        BackgroundColor="Transparent"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnEliminarProductoClicked"/>
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- TOTAL -->
        <Frame x:Name="SummaryPanel"
               Grid.Row="2"
               Padding="15"
               CornerRadius="20"
               BackgroundColor="#111">

            <VerticalStackLayout>

                <Label Text="Total"
                       TextColor="#AAA"/>

                <Label Text="{Binding Total, StringFormat='${0:F2}'}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Button Text="Finalizar compra"
                        BackgroundColor="White"
                        TextColor="#111"
                        Clicked="OnCheckoutClicked"/>

                <Button Text="Seguir comprando"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        Clicked="OnSeguirComprandoClicked"/>
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>