<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.OrderTrackingPage"
             Title="Seguimiento de pedido">
  <Grid RowDefinitions="Auto,*,Auto">
    <Label x:Name="StatusLabel" Grid.Row="0" Text="Estado" FontAttributes="Bold" Padding="12" />
    <Grid Grid.Row="1" HeightRequest="360">
      <WebView x:Name="MapView" HeightRequest="360" Navigated="MapView_Navigated" />
      <Image x:Name="MapFallbackImage" IsVisible="False" Aspect="AspectFill" />
      <Label x:Name="MapErrorLabel" Text="No se pudo cargar el mapa." IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" BackgroundColor="#66000000" Padding="12" />
    </Grid>
    <CollectionView x:Name="HistoryList" Grid.Row="2" HeightRequest="140">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Frame Margin="8" Padding="8">
            <Label Text="{Binding .}" />
          </Frame>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>