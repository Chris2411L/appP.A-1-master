<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.OrderTrackingPage"
             Title="Seguimiento"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16"
          RowSpacing="14">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="#111111"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                Padding="18">

            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            WidthRequest="64"
                            HeightRequest="64">
                        <Label Text="🚚"
                               FontSize="32"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="4">

                        <Label x:Name="StatusLabel"
                               Text="Iniciando entrega..."
                               FontAttributes="Bold"
                               FontSize="20"
                               TextColor="White"/>

                        <Label x:Name="ETALabel"
                               Text="ETA: 3:00 min"
                               FontSize="14"
                               TextColor="#D1D1D6"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- BANNER NOTIFICACIÓN -->
                <Border x:Name="NotificationBanner"
                        IsVisible="False"
                        BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="NotificationText"
                               TextColor="#111111"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center"/>

                        <Button Grid.Column="1"
                                Text="Ver"
                                Clicked="OnNotificationViewClicked"
                                BackgroundColor="#111111"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="36"
                                Padding="16,0"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- MAPA -->
        <Border Grid.Row="1"
                BackgroundColor="#111111"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30">

            <Grid>
                <WebView x:Name="MapView"
                         Navigated="MapView_Navigated"/>

                <Image x:Name="MapFallbackImage"
                       IsVisible="False"
                       Aspect="AspectFill"/>

                <Border BackgroundColor="#CC111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="12"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="14">

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="📍"
                               FontSize="18"/>
                        <Label Text="Ruta en vivo"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="14"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- HISTORIAL -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E5E5EA"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Padding="16"
                HeightRequest="230">

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Ruta de entrega"
                               FontAttributes="Bold"
                               FontSize="20"
                               TextColor="#111111"/>

                        <Label Text="Actualizaciones del pedido"
                               FontSize="13"
                               TextColor="#6E6E73"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="#F2F2F7"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <Label Text="En vivo"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#111111"/>
                    </Border>
                </Grid>

                <CollectionView x:Name="HistoryList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F6F6F6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10"
                                    Margin="0,3">

                                <Label Text="{Binding .}"
                                       FontSize="13"
                                       TextColor="#111111"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button x:Name="ConfirmDeliveryButton"
                        Text="Confirmar entrega"
                        IsVisible="False"
                        Clicked="OnConfirmDeliveryClicked"
                        BackgroundColor="#111111"
                        TextColor="White"
                        HeightRequest="48"
                        CornerRadius="18"
                        FontAttributes="Bold"/>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>