<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.OrderTrackingPage"
             Title="Seguimiento de pedido">
  <Grid RowDefinitions="Auto,*,Auto">
    <Label x:Name="StatusLabel" Grid.Row="0" Text="Estado" FontAttributes="Bold" Padding="12" />
    <WebView x:Name="MapView" Grid.Row="1" HeightRequest="360" />
    <CollectionView x:Name="HistoryList" Grid.Row="2" HeightRequest="140">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Frame Margin="8" Padding="8">
            <Label Text="{Binding .}" />
          </Frame>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>