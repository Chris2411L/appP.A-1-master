<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.MainPage"
             Title="NONTONIO"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">

    <!-- Cleaner, lighter background for a web-like look -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource Secondary}" Offset="0" />
            <GradientStop Color="{StaticResource White}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="📊 Dashboard" Clicked="OnVerDashboardClicked" />
        <ToolbarItem Text="🛒 Carrito" Clicked="OnVerCarritoClicked" />
        <ToolbarItem Text="👤 Perfil" Clicked="OnVerPerfilClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18,14,18,24">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Image Source="nontonio.png" HeightRequest="48" WidthRequest="48" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label x:Name="WelcomeLabel" Text="¡Hola!" Style="{StaticResource PageTitleStyle}" HorizontalOptions="Start"/>
                    <Label Text="Tu tienda rápida y fácil de usar" FontSize="13" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <SearchBar Grid.Column="2" Placeholder="Buscar productos" HorizontalOptions="End" WidthRequest="220" />
            </Grid>

            <Frame Padding="18" CornerRadius="12" HasShadow="True" BorderColor="Transparent" BackgroundColor="{StaticResource White}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="¿Qué se te antoja hoy?" FontSize="20" FontFamily="MontserratSemiBold" TextColor="{StaticResource Gray900}" />
                        <Label Text="Explora nuestras categorías y ofertas seleccionadas" FontSize="13" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                    <Button Text="Ver categorías" Clicked="OnVerCategoriasClicked" HorizontalOptions="End" VerticalOptions="Center" />
                </Grid>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Frame Grid.Column="0" Padding="14" BorderColor="{StaticResource Gray200}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🚚 Entrega" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Mismo día en productos seleccionados" FontSize="13" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Padding="14" BorderColor="{StaticResource Gray200}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="💳 Pago" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Opciones seguras y flexibles" FontSize="13" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Comenzar a Comprar" HeightRequest="56" FontSize="16" Clicked="OnVerCategoriasClicked" HorizontalOptions="FillAndExpand" />
                <Button Text="Ofertas" HeightRequest="56" FontSize="16" BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource Gray600}" HorizontalOptions="End" />
            </HorizontalStackLayout>

            <Button x:Name="ChangeUserButton"
                    Text="Cambiar de Usuario"
                    HeightRequest="48"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Clicked="OnChangeUserClicked"
                    IsVisible="False" />

            <VerticalStackLayout x:Name="AdminPanel" Spacing="10" IsVisible="False">
                <Label Text="Panel de Administración" HorizontalOptions="Center" TextColor="{StaticResource Gray500}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="⚙️ Usuarios" BackgroundColor="{StaticResource Danger}" Clicked="OnPanelUsuariosClicked"/>
                    <Button Grid.Column="1" Text="📦 Almacén" BackgroundColor="{StaticResource Tertiary}" Clicked="OnPanelAlmacenClicked"/>
                    <Button Grid.Column="0" Text="📩 Órdenes" BackgroundColor="{StaticResource Primary}" Clicked="OnPanelOrdenesClicked"/>
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
