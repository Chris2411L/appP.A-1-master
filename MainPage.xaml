<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.MainPage"
             Title="NONTONIO"
             BackgroundColor="#F6F6F6">

    <ScrollView>

        <VerticalStackLayout x:Name="MainContent"
                             Padding="24"
                             Spacing="22">

            <!-- HEADER -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">

                <Border x:Name="LogoSecretButton"
                        BackgroundColor="#111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        WidthRequest="58"
                        HeightRequest="58">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoSecretTapped"/>
                    </Border.GestureRecognizers>

                    <Image Source="nontonio.png"
                           WidthRequest="38"
                           HeightRequest="38"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">

                    <Label x:Name="WelcomeLabel"
                           Text="¡Hola!"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#111111"/>

                    <Label Text="Compra rápido, simple y elegante"
                           FontSize="14"
                           TextColor="#6E6E73"/>
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        x:Name="ChangeUserButton"
                        Text="Salir"
                        IsVisible="False"
                        BackgroundColor="#111111"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="44"
                        Padding="18,0"
                        Clicked="OnChangeUserClicked"/>
            </Grid>

            <!-- HERO -->
            <Border x:Name="HeroCard"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="0"
                    HeightRequest="300">

                <Grid>

                    <Image x:Name="HeroImage"
                           Source="main_store.png"
                           Aspect="AspectFill"/>

                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#AA000000"
                                              Offset="0"/>

                                <GradientStop Color="#66000000"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <VerticalStackLayout Padding="30"
                                         Spacing="14"
                                         VerticalOptions="Center">

                        <Label Text="Tu tienda inteligente"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label Text="Explora productos, controla compras y sigue tus pedidos en una experiencia premium."
                               FontSize="15"
                               TextColor="#E5E5E5"
                               LineHeight="1.25"/>

                        <HorizontalStackLayout Spacing="12"
                                               Margin="0,10,0,0">

                            <Button Text="Ver categorías"
                                    BackgroundColor="White"
                                    TextColor="#111111"
                                    CornerRadius="16"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    Padding="22,0"
                                    Clicked="OnVerCategoriasClicked"/>

                            <Button Text="Carrito"
                                    BackgroundColor="#232323"
                                    TextColor="White"
                                    CornerRadius="16"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    Padding="22,0"
                                    Clicked="OnVerCarritoClicked"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- QUICK ACTIONS -->
            <Grid x:Name="QuickActions"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="14">

                <!-- CATEGORÍAS -->
                <Border Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoriasCardTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">

                        <Label Text="🛍️"
                               FontSize="26"/>

                        <Label Text="Categorías"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <Label Text="Explora la tienda"
                               FontSize="13"
                               TextColor="#6E6E73"/>
                    </VerticalStackLayout>
                </Border>

                <!-- DASHBOARD -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardCardTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">

                        <Label Text="📊"
                               FontSize="26"/>

                        <Label Text="Dashboard"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <Label Text="Métricas y ventas"
                               FontSize="13"
                               TextColor="#6E6E73"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PERFIL -->
                <Border Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilCardTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">

                        <Label Text="👤"
                               FontSize="26"/>

                        <Label Text="Perfil"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <Label Text="Direcciones y pedidos"
                               FontSize="13"
                               TextColor="#6E6E73"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- INFO -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        BackgroundColor="#111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="22">

                    <VerticalStackLayout Spacing="8">

                        <Label Text="🚚 Entrega"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label Text="Seguimiento de pedidos con experiencia tipo delivery."
                               FontSize="14"
                               TextColor="#D1D1D6"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#FFFFFF"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="22">

                    <VerticalStackLayout Spacing="8">

                        <Label Text="💳 Pagos"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <Label Text="Checkout limpio, rápido y fácil de usar."
                               FontSize="14"
                               TextColor="#6E6E73"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- PANEL VENDEDOR -->
            <VerticalStackLayout x:Name="AdminPanel"
                                 Spacing="12"
                                 IsVisible="False">

                <Label Text="Panel de administración"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#111111"/>

                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="12">

                    <Button Grid.Column="0"
                            Text="Usuarios"
                            BackgroundColor="#111111"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            Clicked="OnPanelUsuariosClicked"/>

                    <Button Grid.Column="1"
                            Text="Almacén"
                            BackgroundColor="#111111"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            Clicked="OnPanelAlmacenClicked"/>

                    <Button Grid.Column="2"
                            Text="Órdenes"
                            BackgroundColor="#111111"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            Clicked="OnPanelOrdenesClicked"/>
                </Grid>
            </VerticalStackLayout>

            <!-- BOTÓN IA -->
            <Button x:Name="AIButton"
                    Text="🤖"
                    WidthRequest="74"
                    HeightRequest="74"
                    CornerRadius="37"
                    BackgroundColor="#111111"
                    TextColor="White"
                    FontSize="30"
                    HorizontalOptions="End"
                    Margin="0,10,6,20"
                    Clicked="OnAIButtonClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>