<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:appP.A"
    x:Class="appP.A.AppShell"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource Gray900}"
    Shell.DisabledColor="{StaticResource Gray300}"
    Shell.ForegroundColor="{StaticResource Primary}">

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate local:MainPage}" />
</Shell>
