<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="16,14,16,24">
            <Label Text="Dashboard de decisiones"
                   Style="{StaticResource PageTitleStyle}"/>
            <Label Text="Resumen visual con métricas del proyecto (lectura para revisión)."
                   FontSize="13"
                   TextColor="{StaticResource Gray500}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Padding="12" BorderColor="{StaticResource Gray200}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Órdenes" FontSize="13" TextColor="{StaticResource Gray500}"/>
                        <Label Text="{Binding TotalOrdenes}" FontSize="24" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="12" BorderColor="{StaticResource Gray200}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ingresos" FontSize="13" TextColor="{StaticResource Gray500}"/>
                        <Label Text="{Binding IngresosTotales, StringFormat='{0:C2}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Padding="12" BorderColor="{StaticResource Gray200}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ticket promedio" FontSize="13" TextColor="{StaticResource Gray500}"/>
                        <Label Text="{Binding TicketPromedio, StringFormat='{0:C2}'}" FontSize="20" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="12" BorderColor="{StaticResource Gray200}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Métodos de pago" FontSize="13" TextColor="{StaticResource Gray500}"/>
                        <Label Text="{Binding MetodosActivos}" FontSize="20" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Frame Padding="14" BorderColor="{StaticResource Gray200}" IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gráfica 1 · Ventas por día (últimos 7 días)"
                           Style="{StaticResource SectionTitleStyle}"/>

                    <Grid ColumnDefinitions="*,200" ColumnSpacing="10">
                        <GraphicsView x:Name="BarsChartView" Grid.Column="0" HeightRequest="220" HorizontalOptions="Fill" />

                        <CollectionView x:Name="VentasCollectionView" Grid.Column="1" ItemsSource="{Binding VentasSemanales}" SelectionMode="Single" SelectionChanged="VentasCollectionView_SelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="6">
                                        <Label Text="{Binding Label}" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label Text="{Binding Valor, StringFormat='{0:C0}'}" FontSize="12" VerticalTextAlignment="Center" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" BorderColor="{StaticResource Gray200}" IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gráfica 2 · Distribución por método de pago"
                           Style="{StaticResource SectionTitleStyle}"/>

                    <Grid ColumnDefinitions="200,*" ColumnSpacing="10">
                        <CollectionView x:Name="DistribucionCollectionView" Grid.Column="0" ItemsSource="{Binding DistribucionPago}" SelectionMode="Single" SelectionChanged="DistribucionCollectionView_SelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="6" ColumnSpacing="8">
                                        <BoxView WidthRequest="14" HeightRequest="14" Background="{Binding Color}" VerticalOptions="Center" HorizontalOptions="Start" CornerRadius="3"/>
                                        <Label Text="{Binding Label}" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label Text="{Binding PorcentajeTexto}" FontSize="12" VerticalTextAlignment="Center" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <GraphicsView x:Name="PieChartView" Grid.Column="1" HeightRequest="180" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" BorderColor="{StaticResource Gray200}" IsVisible="{Binding IsClient}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Resumen personal" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Aquí no se muestran métricas de ventas. Revisa tus órdenes recientes abajo." FontSize="13" TextColor="{StaticResource Gray500}"/>
                    <CollectionView ItemsSource="{Binding RecentOrders}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" Padding="6" FontSize="13"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Nota: Página de propuesta para revisión; no está enlazada al flujo principal aún."
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
