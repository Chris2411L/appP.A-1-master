<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#F6F6F6">

    <ScrollView>
        <VerticalStackLayout x:Name="DashboardContent"
                             Padding="18"
                             Spacing="18">

            <!-- HEADER -->
            <Border BackgroundColor="#111111"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="24">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="16">

                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="74"
                            HeightRequest="74">

                        <Label Text="📊"
                               FontSize="36"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="4">

                        <Label x:Name="DashboardTitleLabel"
                               Text="Dashboard"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label x:Name="DashboardSubtitleLabel"
                               Text="Resumen visual de tu actividad."
                               FontSize="14"
                               TextColor="#D1D1D6"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- MÉTRICAS ADMIN -->
            <VerticalStackLayout x:Name="AdminPanel"
                                 IsVisible="False"
                                 Spacing="16">

                <Label Text="Modo administrador"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#111111"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="14"
                      RowSpacing="14">

                    <Border BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="💰"
                                   FontSize="30"/>
                            <Label Text="Ventas totales"
                                   FontSize="13"
                                   TextColor="#6E6E73"/>
                            <Label x:Name="VentasTotalesLabel"
                                   Text="$0.00"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="#111111"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="🛒"
                                   FontSize="30"/>
                            <Label Text="Pedidos del día"
                                   FontSize="13"
                                   TextColor="#6E6E73"/>
                            <Label x:Name="PedidosHoyLabel"
                                   Text="0"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="#111111"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="📦"
                                   FontSize="30"/>
                            <Label Text="Producto más vendido"
                                   FontSize="13"
                                   TextColor="#6E6E73"/>
                            <Label x:Name="ProductoTopLabel"
                                   Text="Sin datos"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#111111"
                                   MaxLines="2"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="🎟️"
                                   FontSize="30"/>
                            <Label Text="Ticket promedio"
                                   FontSize="13"
                                   TextColor="#6E6E73"/>
                            <Label x:Name="TicketPromedioLabel"
                                   Text="$0.00"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="#111111"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- GRÁFICA SIMPLE -->
                <Border BackgroundColor="#111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Padding="20">

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="📈 Ventas últimos 7 días"
                                       FontSize="21"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                                <Label Text="Gráfica simple para revisar el movimiento reciente."
                                       FontSize="13"
                                       TextColor="#D1D1D6"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="Admin"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalTextAlignment="Center"/>
                        </Grid>

                        <GraphicsView x:Name="SalesChartView"
                                      HeightRequest="240"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PRODUCTOS MÁS VENDIDOS -->
                <Border BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="📦 Productos más vendidos"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <CollectionView x:Name="ProductosVendidosList"
                                        SelectionMode="None"
                                        HeightRequest="220">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto"
                                          Padding="6"
                                          ColumnSpacing="12">

                                        <Label Text="{Binding Nombre}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#111111"
                                               VerticalTextAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#111111"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="12,5">

                                            <Label Text="{Binding Cantidad, StringFormat='{0} vendidos'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- PANEL CLIENTE -->
            <VerticalStackLayout x:Name="ClientPanel"
                                 IsVisible="False"
                                 Spacing="16">

                <Label Text="Resumen personal"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#111111"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14">

                    <Border BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="🛍️"
                                   FontSize="30"/>
                            <Label Text="Mis pedidos"
                                   FontSize="13"
                                   TextColor="#6E6E73"/>
                            <Label x:Name="MisPedidosLabel"
                                   Text="0"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="#111111"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="💳"
                                   FontSize="30"/>
                            <Label Text="Total gastado"
                                   FontSize="13"
                                   TextColor="#6E6E73"/>
                            <Label x:Name="MiGastoLabel"
                                   Text="$0.00"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="#111111"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="#111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Padding="20">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Últimos pedidos"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <CollectionView x:Name="RecentOrdersList"
                                        SelectionMode="None"
                                        HeightRequest="220">

                            <CollectionView.EmptyView>
                                <Label Text="Aún no tienes pedidos registrados."
                                       TextColor="#D1D1D6"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Orden">
                                    <Border BackgroundColor="#1C1C1E"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            Padding="14"
                                            Margin="0,5">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Fecha, StringFormat='{0:dd MMM yyyy}'}"
                                                       TextColor="White"
                                                       FontAttributes="Bold"/>

                                                <Label Text="{Binding MetodoPago}"
                                                       TextColor="#D1D1D6"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Total, StringFormat='{0:C2}'}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>