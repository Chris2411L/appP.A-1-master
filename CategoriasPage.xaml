<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.CategoriasPage"
             Title="Categorías"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Label Text="Explora por categorías" Style="{StaticResource PageTitleStyle}"/>
            <Label Text="Selecciona una categoría para ver productos" HorizontalOptions="Center" FontSize="13" TextColor="{StaticResource Gray500}" />

            <CollectionView x:Name="CategoriasList" SelectionMode="Single" SelectionChanged="OnCategoriaSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Categoria">
                        <Frame HeightRequest="170" Padding="0" CornerRadius="22" HasShadow="True" BorderColor="Transparent">
                            <Grid>
                                <BoxView>
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource Primary}" Offset="0.0"/>
                                            <GradientStop Color="{StaticResource Tertiary}" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="12" Padding="12">
                                    <Label Text="📦" FontSize="38" HorizontalOptions="Center"/>
                                    <Label Text="{Binding Nombre}" TextColor="White" FontAttributes="Bold" FontSize="17" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                    <Label Text="Toca para abrir" TextColor="{StaticResource Gray100}" FontSize="12" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
