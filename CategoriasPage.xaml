<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.CategoriasPage"
             Title="Categorías"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="16"
          RowSpacing="16">

        <!-- IMAGEN SUPERIOR -->
        <Border x:Name="TopImageCard"
                Grid.Row="0"
                HeightRequest="220"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0">

            <Grid>
                <Image Source="main_store.jpg"
                       Aspect="AspectFill"/>

                <BoxView BackgroundColor="#88000000"/>

                <VerticalStackLayout Padding="25"
                                     VerticalOptions="Center">
                    <Label Text="Categorías NONTONIO"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Explora tu tienda de forma premium"
                           FontSize="14"
                           TextColor="#EEEEEE"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- HEADER -->
        <Label Grid.Row="1"
               Text="Categorías"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#111"/>

        <!-- 🔥 ADMIN PANEL -->
        <VerticalStackLayout x:Name="AdminPanel"
                             Grid.Row="2"
                             IsVisible="False"
                             Spacing="10">

            <Label Text="Modo Administrador"
                   FontAttributes="Bold"
                   TextColor="#111"
                   FontSize="16"/>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10">

                <Button Grid.Column="0"
                        Text="Agregar"
                        BackgroundColor="#111"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="OnAgregarCategoriaClicked"/>

                <Button Grid.Column="1"
                        Text="Productos"
                        BackgroundColor="#111"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="OnGestionarProductosClicked"/>

                <Button Grid.Column="2"
                        Text="Actualizar"
                        BackgroundColor="White"
                        TextColor="#111"
                        BorderColor="#CCC"
                        BorderWidth="1"
                        CornerRadius="12"
                        Clicked="OnActualizarVistaClicked"/>
            </Grid>

        </VerticalStackLayout>

        <!-- LISTA -->
        <CollectionView x:Name="CategoriasList"
                        Grid.Row="3"
                        SelectionMode="Single"
                        SelectionChanged="OnCategoriaSelected">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Categoria">

                    <Border BackgroundColor="White"
                            Stroke="#DDD"
                            StrokeShape="RoundRectangle 20"
                            Padding="15">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="{Binding Imagen}"
                                   FontSize="30"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="{Binding Nombre}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>