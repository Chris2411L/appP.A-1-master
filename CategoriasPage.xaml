<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.CategoriasPage"
             Title="Categorías"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Label Text="Explora por categorías" Style="{StaticResource PageTitleStyle}"/>
            <Label Text="Selecciona una categoría para ver productos" FontSize="13" TextColor="{StaticResource Gray500}" />

            <CollectionView x:Name="CategoriasList" SelectionMode="Single" SelectionChanged="OnCategoriaSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Categoria">
                        <Frame HeightRequest="160" Padding="0" CornerRadius="12" HasShadow="True" BorderColor="{StaticResource Gray200}" BackgroundColor="{StaticResource White}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Source="{Binding Imagen, Converter={StaticResource ImageFallbackConverter}}" Aspect="AspectFill" Grid.Row="0"/>
                                <VerticalStackLayout Grid.Row="1" Padding="12" BackgroundColor="{StaticResource Secondary}">
                                    <Label Text="{Binding Nombre}" TextColor="{StaticResource Gray900}" FontAttributes="Bold" FontSize="16" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
