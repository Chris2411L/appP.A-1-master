<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.AlmacenAdminPage"
             Title="Control de Almacén"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="18"
          RowSpacing="16">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="#111111"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                Padding="22">

            <VerticalStackLayout Spacing="14">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="70"
                            HeightRequest="70">
                        <Label Text="🏪"
                               FontSize="34"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="4">
                        <Label Text="Inventario General"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label Text="Gestiona stock, productos y categorías del almacén."
                               FontSize="14"
                               TextColor="#D1D1D6"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- BUSCADOR -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="8,0">

                    <SearchBar x:Name="SearchBox"
                               Placeholder="Buscar producto por nombre..."
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="Transparent"
                               TextColor="#111111"
                               PlaceholderColor="#8E8E93"/>
                </Border>

                <!-- FILTRO -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,0">

                    <Picker x:Name="CategoriaPicker"
                            Title="Filtrar por categoría"
                            SelectedIndexChanged="OnCategoriaChanged"
                            TextColor="#111111"
                            TitleColor="#8E8E93"/>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- LISTA DE PRODUCTOS -->
        <CollectionView Grid.Row="1"
                        x:Name="ProductosList"
                        ItemsSource="{Binding ProductosFiltrados}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label Text="📦"
                           FontSize="52"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="No hay productos"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#111111"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Agrega productos o cambia los filtros."
                           FontSize="14"
                           TextColor="#6E6E73"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Producto">

                    <Border BackgroundColor="White"
                            Stroke="#E5E5EA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="14"
                            Margin="0,6">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14">

                            <!-- IMAGEN -->
                            <Border BackgroundColor="#F2F2F7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="72"
                                    HeightRequest="72">

                                <Image Source="{Binding Imagen, Converter={StaticResource ImageFallbackConverter}}"
                                       Aspect="AspectFill"/>
                            </Border>

                            <!-- INFO -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="5">

                                <Label Text="{Binding Nombre}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#111111"
                                       MaxLines="2"/>

                                <Label Text="{Binding Categoria}"
                                       FontSize="13"
                                       TextColor="#6E6E73"/>

                                <Border BackgroundColor="#F2F2F7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="10,5"
                                        HorizontalOptions="Start">

                                    <Label Text="{Binding Stock, StringFormat='Stock: {0} piezas'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#111111"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- ACCIONES -->
                            <VerticalStackLayout Grid.Column="2"
                                                 VerticalOptions="Center"
                                                 Spacing="8">

                                <HorizontalStackLayout Spacing="8"
                                                       HorizontalOptions="End">

                                    <Button Text="-"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            Padding="0"
                                            CornerRadius="19"
                                            BackgroundColor="#FF3B30"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnRestarStock"/>

                                    <Button Text="+"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            Padding="0"
                                            CornerRadius="19"
                                            BackgroundColor="#111111"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnSumarStock"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="8"
                                                       HorizontalOptions="End">

                                    <Button Text="Editar"
                                            HeightRequest="36"
                                            CornerRadius="14"
                                            Padding="14,0"
                                            BackgroundColor="#F2F2F7"
                                            TextColor="#111111"
                                            FontAttributes="Bold"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEditarStock"/>

                                    <Button Text="Eliminar"
                                            HeightRequest="36"
                                            CornerRadius="14"
                                            Padding="14,0"
                                            BackgroundColor="#FF3B30"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEliminarProductoClicked"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- BOTÓN AGREGAR -->
        <Button Grid.Row="2"
                Text="Agregar producto"
                BackgroundColor="#111111"
                TextColor="White"
                HeightRequest="58"
                CornerRadius="20"
                FontAttributes="Bold"
                FontSize="16"
                Clicked="OnAgregarProductoClicked"/>

    </Grid>
</ContentPage>