<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:appP.A.Models"
             x:Class="appP.A.ProductosPage"
             Title="Productos"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*, Auto" Padding="12,10">
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="4,0,4,10">
            <Label Text="Productos disponibles" Style="{StaticResource PageTitleStyle}" HorizontalOptions="Start"/>
            <Label Text="Añade al carrito con un toque" FontSize="13" TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <CollectionView x:Name="ProductosList" Grid.Row="1" Margin="0,4,0,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Producto">
                    <Frame Padding="0" CornerRadius="12" HasShadow="True" BorderColor="{StaticResource Gray200}" BackgroundColor="{StaticResource White}">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="140">
                                <Image Source="{Binding Imagen, Converter={StaticResource ImageFallbackConverter}}" Aspect="AspectFill"/>
                                <BoxView BackgroundColor="#80000000" IsVisible="False"/>
                            </Grid>
                            <VerticalStackLayout Padding="12" Spacing="6">
                                <Label Text="{Binding Nombre}" FontSize="15" FontFamily="MontserratSemiBold" TextColor="{StaticResource Gray900}" MaxLines="1"/>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding Precio, StringFormat='{0:C2}'}" FontSize="16" FontFamily="MontserratSemiBold" TextColor="{StaticResource Primary}"/>
                                    <Button Text="Añadir" 
                                            BackgroundColor="{StaticResource Primary}" 
                                            TextColor="White" 
                                            FontSize="13"
                                            HeightRequest="40"
                                            CornerRadius="8"
                                            Clicked="OnAgregarAlCarritoClicked" 
                                            CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="🛒 Ver carrito" BackgroundColor="{StaticResource Primary}" TextColor="White" 
                FontAttributes="Bold" Margin="8,14,8,6" CornerRadius="12" HeightRequest="52" 
                Clicked="OnVerCarritoClicked"/>
    </Grid>
</ContentPage>
