<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.SeguimientoPage"
             Title="Seguimiento"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto, *" Padding="12">
        <Label Text="Seguimiento de pedidos" FontAttributes="Bold" FontSize="20" />
        <CollectionView x:Name="TrackingOrdersList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnTrackingOrderSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="12" Padding="12" Margin="6" BorderColor="{StaticResource Gray200}">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Fecha, StringFormat='{0:g}'}" FontAttributes="Bold" />
                                <Label Text="{Binding Direccion}" FontSize="12" />
                                <Label Text="{Binding Status}" FontSize="12" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Button Text="Ver" Clicked="OnVerTrackingClicked" CommandParameter="{Binding .}" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>