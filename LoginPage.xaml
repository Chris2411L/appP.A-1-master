<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.LoginPage"
             Title="Bienvenido"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center">
            <!-- Hero -->
            <Frame Padding="0" CornerRadius="12" BorderColor="Transparent" IsClippedToBounds="True" HasShadow="True" WidthRequest="720">
                <Grid HeightRequest="140">
                    <Image Source="bebidas.jpg.jpg" Aspect="AspectFill" />
                    <BoxView Opacity="0.32" Color="{StaticResource Primary}" />
                    <HorizontalStackLayout Padding="16" VerticalOptions="Center" HorizontalOptions="Start" Spacing="12">
                        <Image Source="nontonio.png" HeightRequest="56" WidthRequest="56"/>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="NONTONIO" Style="{StaticResource PageTitleStyle}" TextColor="White" />
                            <Label Text="Inicia sesión para continuar" FontSize="13" TextColor="{StaticResource SecondaryDarkText}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Card -->
            <Frame CornerRadius="12" Padding="18" HasShadow="True" BorderColor="{StaticResource Gray200}" BackgroundColor="{StaticResource White}" WidthRequest="720">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Acceso a tu cuenta" Style="{StaticResource SectionTitleStyle}" />

                    <VerticalStackLayout Spacing="10">
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" BackgroundColor="{StaticResource Secondary}">
                            <Entry x:Name="UsernameEntry" Placeholder="Nombre de usuario" Keyboard="Text" BackgroundColor="Transparent" Margin="6" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="{StaticResource Gray900}" PlaceholderColor="{StaticResource Gray400}" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" BackgroundColor="{StaticResource Secondary}">
                            <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" BackgroundColor="Transparent" Margin="6" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="{StaticResource Gray900}" PlaceholderColor="{StaticResource Gray400}" />
                        </Border>

                        <Label Text="Verificación rápida" FontSize="12" TextColor="{StaticResource Gray600}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label x:Name="CaptchaLabel" Text="0 + 0 =" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                            <Entry x:Name="CaptchaEntry" Grid.Column="1" Placeholder="?" WidthRequest="70" Keyboard="Numeric" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray900}" />
                            <Button Grid.Column="2" Text="↻" Clicked="OnRefreshCaptchaClicked" Style="{StaticResource SecondaryButtonStyle}" Padding="10,0" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Button x:Name="LoginButton" Text="INGRESAR A LA TIENDA" Clicked="OnLoginClicked" HeightRequest="52" FontAttributes="Bold" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" Pressed="OnButtonPressed" Released="OnButtonReleased" />
                        <Button Text="Crear una cuenta" Clicked="OnRegisterClicked" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="48" />
                    </VerticalStackLayout>

                    <Frame IsVisible="False" x:Name="MessageFrame" Padding="8" CornerRadius="8" BackgroundColor="{StaticResource Danger}" HasShadow="False">
                        <Label x:Name="MessageLabel" TextColor="{StaticResource White}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
