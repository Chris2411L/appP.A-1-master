<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.LoginPage"
             Title="Bienvenido"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Frame Padding="0" CornerRadius="22" BorderColor="Transparent" IsClippedToBounds="True" HasShadow="True">
                <Grid HeightRequest="180">
                    <Image Source="bebidas.jpg.jpg" Aspect="AspectFill" />
                    <BoxView Opacity="0.35" Color="{StaticResource Black}" />
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                        <Image Source="nontonio.png" HeightRequest="70"/>
                        <Label Text="NONTONIO" Style="{StaticResource PageTitleStyle}" TextColor="White"/>
                        <Label Text="Inicia sesión para continuar" FontSize="13" TextColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame CornerRadius="18" Padding="18" HasShadow="False"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                   BorderColor="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Acceso" Style="{StaticResource SectionTitleStyle}" />
                    <Entry x:Name="UsernameEntry" Placeholder="Nombre de usuario" Keyboard="Text" />
                    <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" />
                    <Label Text="Verificación rápida" FontSize="12" TextColor="{StaticResource Gray500}" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label x:Name="CaptchaLabel" Text="0 + 0 =" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" />
                        <Entry x:Name="CaptchaEntry" Grid.Column="1" Placeholder="?" WidthRequest="70" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                        <Button Grid.Column="2" Text="↻" Clicked="OnRefreshCaptchaClicked" Style="{StaticResource SecondaryButtonStyle}" Padding="10,0"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Button Text="INGRESAR A LA TIENDA" Clicked="OnLoginClicked" HeightRequest="52" />
            <Button Text="Crear una cuenta" Clicked="OnRegisterClicked" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="48" />
            <Label x:Name="MessageLabel" TextColor="{StaticResource Danger}" IsVisible="False" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
