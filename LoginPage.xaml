<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.LoginPage"
             Title="Login"
             BackgroundColor="#0A0A0A">

    <ScrollView>
        <Grid x:Name="ResponsiveGrid"
              RowDefinitions="Auto"
              ColumnDefinitions="*,*"
              MinimumHeightRequest="720">

            <!-- IMAGEN / HERO -->
            <Grid x:Name="HeroPanel"
                  Grid.Column="0"
                  IsClippedToBounds="True"
                  MinimumHeightRequest="720">

                <Image x:Name="HeroImage"
                       Source="login_store.jpg"
                       Aspect="AspectFill"/>

                <BoxView Color="#70000000"/>

                <VerticalStackLayout x:Name="HeroText"
                                     Padding="50"
                                     Spacing="12"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="Compra fácil, rápido y moderno"
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Tu tienda inteligente con estilo premium"
                           FontSize="16"
                           TextColor="#D1D5DB"
                           HorizontalTextAlignment="Center"
                           MaximumWidthRequest="460"/>
                </VerticalStackLayout>
            </Grid>

            <!-- LOGIN -->
            <Grid x:Name="LoginPanel"
                  Grid.Column="1"
                  BackgroundColor="#0A0A0A"
                  Padding="24"
                  MinimumHeightRequest="720">

                <Border x:Name="LoginCard"
                        WidthRequest="360"
                        MaximumWidthRequest="420"
                        Padding="32"
                        BackgroundColor="#111111"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Border.Shadow>
                        <Shadow Brush="#99000000"
                                Offset="0,24"
                                Radius="65"
                                Opacity="0.85"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <!-- LOGO -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Image x:Name="LogoIcon"
                                   Source="icono_login.png"
                                   WidthRequest="62"
                                   HeightRequest="62"/>

                            <Label Text="NONTONIO"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Accede a tu cuenta"
                                   FontSize="13"
                                   TextColor="#A1A1AA"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- USUARIO -->
                        <Border BackgroundColor="#1C1C1E"
                                Stroke="#2F2F32"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="👤"
                                       FontSize="16"
                                       VerticalOptions="Center"/>

                                <Entry x:Name="UsernameEntry"
                                       Grid.Column="1"
                                       Placeholder="Usuario"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="White"
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       Focused="OnEntryFocused"
                                       Unfocused="OnEntryUnfocused"/>
                            </Grid>
                        </Border>

                        <!-- CONTRASEÑA -->
                        <Border BackgroundColor="#1C1C1E"
                                Stroke="#2F2F32"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="🔒"
                                       FontSize="16"
                                       VerticalOptions="Center"/>

                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Contraseña"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="White"
                                       FontSize="14"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       Focused="OnEntryFocused"
                                       Unfocused="OnEntryUnfocused"/>
                            </Grid>
                        </Border>

                        <!-- CAPTCHA -->
                        <Grid x:Name="CaptchaGrid"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8">

                            <Border BackgroundColor="#1C1C1E"
                                    Stroke="#2F2F32"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 13"
                                    Padding="13">
                                <Label x:Name="CaptchaLabel"
                                       Text="0 + 0 ="
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="#1C1C1E"
                                    Stroke="#2F2F32"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 13"
                                    Padding="10,0">
                                <Entry x:Name="CaptchaEntry"
                                       Placeholder="Resultado"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="White"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       HorizontalTextAlignment="Center"/>
                            </Border>

                            <Button Grid.Column="2"
                                    Text="↻"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    CornerRadius="13"
                                    BackgroundColor="White"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    Clicked="OnRefreshCaptchaClicked"/>
                        </Grid>

                        <!-- BOTÓN LOGIN -->
                        <Button x:Name="LoginButton"
                                Text="Entrar"
                                HeightRequest="52"
                                CornerRadius="15"
                                BackgroundColor="White"
                                TextColor="Black"
                                FontAttributes="Bold"
                                Clicked="OnLoginClicked"
                                Pressed="OnButtonPressed"
                                Released="OnButtonReleased"/>

                        <!-- CREAR CUENTA -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="¿No tienes cuenta?"
                                   TextColor="#9CA3AF"
                                   FontSize="13"/>

                            <Label Text="Crear cuenta"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Label x:Name="MessageLabel"
                               IsVisible="False"
                               TextColor="#FF453A"
                               FontSize="13"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>