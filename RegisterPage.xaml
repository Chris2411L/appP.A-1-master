<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.RegisterPage"
             Title="Crear Cuenta"
             BackgroundColor="#070707">

    <Grid ColumnDefinitions="*,*" RowDefinitions="*">

        <Grid Grid.Column="0" IsClippedToBounds="True">
            <Image x:Name="HeroImage"
                   Source="register.jpg"
                   Aspect="AspectFill"/>

            <BoxView Color="#70000000"/>

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Padding="55"
                                 Spacing="12">

                <Label Text="Crea tu cuenta"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Elige si quieres comprar, repartir o vender dentro de NONTONIO."
                       FontSize="16"
                       TextColor="#D1D5DB"
                       HorizontalTextAlignment="Center"
                       WidthRequest="430"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="1" BackgroundColor="#070707">

            <Border x:Name="RegisterCard"
                    WidthRequest="390"
                    Padding="32"
                    BackgroundColor="#111111"
                    Stroke="#2A2A2A"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Image Source="icono_register.png"
                               WidthRequest="58"
                               HeightRequest="58"/>

                        <Label Text="NONTONIO"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Registro de usuario"
                               FontSize="13"
                               TextColor="#A1A1AA"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#1C1C1E"
                            Stroke="#2F2F32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="👤" FontSize="16" VerticalOptions="Center"/>

                            <Entry x:Name="UsernameEntry"
                                   Grid.Column="1"
                                   Placeholder="Nombre de usuario"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="White"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   Focused="OnEntryFocused"
                                   Unfocused="OnEntryUnfocused"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#1C1C1E"
                            Stroke="#2F2F32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="🔒" FontSize="16" VerticalOptions="Center"/>

                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="1"
                                   Placeholder="Contraseña"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="White"
                                   FontSize="14"
                                   IsPassword="True"
                                   BackgroundColor="Transparent"
                                   Focused="OnEntryFocused"
                                   Unfocused="OnEntryUnfocused"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#1C1C1E"
                            Stroke="#2F2F32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✅" FontSize="16" VerticalOptions="Center"/>

                            <Entry x:Name="ConfirmPasswordEntry"
                                   Grid.Column="1"
                                   Placeholder="Confirmar contraseña"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="White"
                                   FontSize="14"
                                   IsPassword="True"
                                   BackgroundColor="Transparent"
                                   Focused="OnEntryFocused"
                                   Unfocused="OnEntryUnfocused"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#1C1C1E"
                            Stroke="#2F2F32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,0">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="🧭"
                                   FontSize="16"
                                   VerticalOptions="Center"/>

                            <Picker x:Name="RolePicker"
                                    Grid.Column="1"
                                    Title="¿Qué quieres ser?"
                                    TextColor="White"
                                    TitleColor="#9CA3AF"
                                    BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>Cliente</x:String>
                                    <x:String>Repartidor</x:String>
                                    <x:String>Vendedor</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border BackgroundColor="#1C1C1E"
                                Stroke="#2F2F32"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="13">
                            <Label x:Name="CaptchaLabel"
                                   Text="0 + 0 ="
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#1C1C1E"
                                Stroke="#2F2F32"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="10,0">

                            <Entry x:Name="CaptchaEntry"
                                   Placeholder="Resultado"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="White"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   HorizontalTextAlignment="Center"/>
                        </Border>

                        <Button Grid.Column="2"
                                Text="↻"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="13"
                                BackgroundColor="#FFFFFF"
                                TextColor="Black"
                                FontAttributes="Bold"
                                Clicked="OnRefreshCaptchaClicked"/>
                    </Grid>

                    <Button x:Name="RegisterButton"
                            Text="Crear cuenta"
                            HeightRequest="52"
                            CornerRadius="15"
                            BackgroundColor="White"
                            TextColor="Black"
                            FontAttributes="Bold"
                            Clicked="OnRegisterClicked"
                            Pressed="OnButtonPressed"
                            Released="OnButtonReleased"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="¿Ya tienes cuenta?"
                               TextColor="#9CA3AF"
                               FontSize="13"/>

                        <Label Text="Volver al login"
                               TextColor="White"
                               FontSize="13"
                               FontAttributes="Bold">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTextTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Label x:Name="MessageLabel"
                           IsVisible="False"
                           TextColor="#FF453A"
                           FontSize="13"
                           HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>