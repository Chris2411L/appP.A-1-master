<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appP.A.CheckoutPage"
             Title="Finalizar compra"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto" Padding="18" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Finalizar compra"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#111111"/>

            <Label Text="Confirma tu dirección, pago y ubicación exacta."
                   FontSize="14"
                   TextColor="#6E6E73"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="CheckoutContent" Spacing="18">

                <Border BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 26"
                        Padding="18">

                    <VerticalStackLayout Spacing="14">

                        <Label Text="1. Dirección de entrega"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <Picker x:Name="SavedAddressesPicker"
                                Title="Selecciona una dirección guardada"
                                SelectedIndexChanged="OnSavedAddressChanged"
                                TextColor="#111111"
                                TitleColor="#8E8E93"/>

                        <Button Text="Gestionar direcciones"
                                BackgroundColor="#F2F2F7"
                                TextColor="#111111"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                Clicked="OnGoToProfileClicked"/>

                        <Label x:Name="DireccionSeleccionadaLabel"
                               Text="Ninguna dirección seleccionada"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 26"
                        Padding="14">

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="Ubicación precisa"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#111111"/>

                                <Label Text="Toca el mapa para marcar tu casa si la dirección no cae exacta."
                                       FontSize="13"
                                       TextColor="#6E6E73"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="📍"
                                    BackgroundColor="#111111"
                                    TextColor="White"
                                    CornerRadius="16"
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    Clicked="OnCentrarMapaClicked"/>
                        </Grid>

                        <Border StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                HeightRequest="300"
                                BackgroundColor="#111111">

                            <WebView x:Name="MapView"
                                     Navigating="MapView_Navigating"/>
                        </Border>

                        <Label x:Name="MapaPrecisionLabel"
                               Text="Todavía no se ha marcado una ubicación manual."
                               FontSize="13"
                               TextColor="#6E6E73"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E5E5EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 26"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="2. Método de pago"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#111111"/>

                        <Picker x:Name="PaymentPicker"
                                Title="Elige cómo pagar"
                                TextColor="#111111"
                                TitleColor="#8E8E93">
                            <Picker.Items>
                                <x:String>💳 Tarjeta de Crédito/Débito</x:String>
                                <x:String>📱 Mercado Pago</x:String>
                                <x:String>💵 Pago en OXXO</x:String>
                                <x:String>🚚 Pago contra entrega</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Padding="22">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Resumen de pago"
                               TextColor="White"
                               FontSize="20"
                               FontAttributes="Bold"/>

                        <Label x:Name="DeliveryDateLabel"
                               TextColor="#D1D1D6"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="10">

                            <Label Grid.Row="0" Text="Productos" TextColor="#D1D1D6"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="SubtotalLabel" TextColor="White"/>

                            <Label Grid.Row="1" Text="IVA (16%)" TextColor="#D1D1D6"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="IvaLabel" TextColor="White"/>

                            <Label Grid.Row="2" Text="Tarifa" TextColor="#D1D1D6"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="TarifaLabel" TextColor="White"/>

                            <Label Grid.Row="3" Text="Envío" TextColor="#D1D1D6"/>
                            <Label Grid.Row="3" Grid.Column="1" x:Name="ShippingLabel" TextColor="White"/>

                            <BoxView Grid.Row="4" Grid.ColumnSpan="2" HeightRequest="1" Color="#333333" Margin="0,8"/>

                            <Label Grid.Row="5" Text="TOTAL"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White"/>

                            <Label Grid.Row="5" Grid.Column="1"
                                   x:Name="TotalLabel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                x:Name="PayButton"
                Text="Pagar ahora"
                BackgroundColor="#111111"
                TextColor="White"
                HeightRequest="58"
                CornerRadius="20"
                FontAttributes="Bold"
                FontSize="16"
                Clicked="OnConfirmOrderClicked"/>
    </Grid>
</ContentPage>