<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="appP.A.AIStoreAssistantPage"
    Title="NONTONIO AI"
    BackgroundColor="#000000">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="#111111"
                StrokeThickness="0"
                Padding="20">

            <HorizontalStackLayout Spacing="14">

                <Border BackgroundColor="#2563EB"
                        WidthRequest="58"
                        HeightRequest="58"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">

                    <Label Text="🤖"
                           FontSize="30"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <VerticalStackLayout VerticalOptions="Center">

                    <Label Text="NONTONIO AI"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Asistente inteligente premium"
                           FontSize="13"
                           TextColor="#AAAAAA"/>
                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Border>

        <!-- CHAT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout x:Name="ChatContainer"
                                 Padding="14"
                                 Spacing="14"/>
        </ScrollView>

        <!-- INPUT -->
        <Border Grid.Row="2"
                BackgroundColor="#111111"
                StrokeThickness="0"
                Padding="14">

            <Grid ColumnDefinitions="*,60,60"
                  ColumnSpacing="10">

                <Entry x:Name="MessageEntry"
                       Grid.Column="0"
                       Placeholder="Pregúntame lo que quieras..."
                       PlaceholderColor="#888"
                       TextColor="White"
                       BackgroundColor="#1C1C1E"
                       HeightRequest="55"/>

                <!-- VOZ -->
                <Button Grid.Column="1"
                        x:Name="VoiceToggleButton"
                        Text="🔊"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="18"
                        Clicked="OnToggleVoiceClicked"/>

                <!-- ENVIAR -->
                <Button Grid.Column="2"
                        Text="➤"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="18"
                        Clicked="OnSendClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>